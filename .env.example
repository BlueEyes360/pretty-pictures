# Optional: a public, read-only JSON gallery. Never put secrets in VITE_* values.
VITE_IMAGES_URL=/gallery.json

# HARVARD_API_KEY is only used by Node, via the shell or ignored .env.harvard file.
# npm start / npm run preview load it for the local gallery builder service.
# npm run refresh:catalog needs no key for existing Harvard object IDs (public IIIF).
# npm run refresh:catalog:api loads .env.harvard and discovers more paintings.
# Viewing saved JSON does not require a key; building galleries requires the local service and key.
