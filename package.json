{
  "name": "pretty-pictures",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.13.0 || ^24.0.0 || >=26.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env.harvard node_modules/vite/bin/vite.js --host 127.0.0.1",
    "dev": "node --env-file-if-exists=.env.harvard node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "refresh:discovery": "node --env-file-if-exists=.env.harvard scripts/refresh-discovery.mjs",
    "preview": "node --env-file-if-exists=.env.harvard node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:coverage && npm run build && npm run test:e2e",
    "import:images": "node --env-file-if-exists=.env.harvard scripts/import-images.mjs",
    "refresh:catalog": "node --env-file-if-exists=.env.harvard scripts/refresh-catalog.mjs",
    "refresh:catalog:api": "node --env-file-if-exists=.env.harvard scripts/refresh-catalog.mjs --source api"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "overrides": {
    "eslint": { "minimatch": "11.0.5" },
    "@eslint/config-array": { "minimatch": "11.0.5" }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
